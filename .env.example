# Course Catalog — environment configuration
# Copy this file to .env and edit the values below.
# docker-compose reads .env automatically.

# ── Path to your courses/training materials ───────────────────────────────────
# Windows (Docker Desktop with WSL2): use forward slashes
COURSES_PATH=C:/Users/Me/Videos/My Courses
# Linux / macOS:
# COURSES_PATH=/home/me/courses
# Windows network share (UNC):
# COURSES_PATH=//fileserver/Schulungen/ELO

# ── Server ports ──────────────────────────────────────────────────────────────
PORT=5000
ES_PORT=9200
KIBANA_PORT=5601

# ── Backend settings ──────────────────────────────────────────────────────────
DEBUG=false
MAX_RESULTS=50
MAX_MATCHES_PER_FILE=5
MAX_FILE_SIZE_MB=50

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ES_INDEX=course_catalog
