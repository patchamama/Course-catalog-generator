# Normalise line endings so the same checkout works on Windows, macOS and Ubuntu.
* text=auto

# Shell scripts must stay LF — CRLF breaks them on macOS / Linux ("bad interpreter: bash\r")
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Windows launchers stay CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.ico  binary
*.icns binary
*.gz   binary
*.tgz  binary
